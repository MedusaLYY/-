# 依赖与产物
node_modules/
dist-ssr/
*.local
# 注意：dist/ 刻意不忽略 —— 内网部署直接使用这份静态产物，不依赖 Node。
# 详见 docs/内网部署说明.md

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# 数据自检脚本的中间产物
scripts/.check-data.bundle.mjs

# 临时走查产物
shots/

# AI 助手的工作记忆（项目内部约定与踩坑记录，不入库）
.workbuddy-ai/

# 仓库探测/临时脚本
*.tmp.mjs
*.tmp.bundle.mjs
.repo-probe.tmp.json
